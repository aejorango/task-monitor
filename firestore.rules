// Firestore Security Rules
//
// Schema layering:
//   workspaces/{id}    — top-level container; has members[] and acl{uid:role}
//   projects/{id}      — workspaceId field; project-level ACL nested inside a workspace
//   tasks, activities,
//   taskComments,
//   templates, savedViews,
//   webhooks           — workspaceId field; access derived from workspace membership

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Approval gate ──────────────────────────────────────────────────────
    // Signing in with Google is not the same as being let in. Every account
    // starts at users/{uid}.status == 'pending' and a superadmin approves it.
    // App.jsx routes unapproved people to the waiting screen, but that is only
    // a screen — without this check the SDK is wide open to anyone with a
    // Google account. Approval is therefore folded into every access primitive
    // below, so a rule written later is gated by construction.
    //
    // The one deliberate exception is users/{self}: a brand-new account has to
    // be able to create and read its own profile, or it could never be
    // approved in the first place. That block spells out its own conditions.
    function isApproved() {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isOwner(resource) {
      return isApproved()
          && request.auth.uid == resource.data.userId;
    }
    function isCreatingOwn() {
      return isApproved()
          && request.auth.uid == request.resource.data.userId;
    }

    // ─── User profile / approval helpers ────────────────────────────────────
    // Hardcoded superadmin emails. Mirrored in src/services/firebase.js so
    // both client and rules agree on who is auto-approved.
    function isSuperadminEmail(email) {
      return email == 'blueinnovation.ph@gmail.com'
          || email == 'aejorango888@gmail.com';
    }
    function isApprovedSuperadmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // ─── Workspace helpers ──────────────────────────────────────────────────
    function isWorkspaceMember(workspaceId) {
      return isApproved()
          && workspaceId is string
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }
    function workspaceRole(workspaceId) {
      return isApproved()
          && workspaceId is string
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
          ? get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.acl[request.auth.uid]
          : null;
    }
    function isWorkspaceOwner(workspaceId) { return workspaceRole(workspaceId) == 'owner'; }
    function isWorkspaceAdmin(workspaceId) {
      let r = workspaceRole(workspaceId);
      return r == 'owner' || r == 'admin';
    }
    function canEditWorkspace(workspaceId) {
      let r = workspaceRole(workspaceId);
      return r == 'owner' || r == 'admin' || r == 'editor';
    }

    // ─── Project helpers (per-project ACL inside a workspace) ───────────────
    function isProjectMember(projectId) {
      return isApproved()
          && projectId is string
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
    }
    function hasProjectRole(projectId, role) {
      return isApproved()
          && projectId is string
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.acl[request.auth.uid] == role;
    }
    function canEditProject(projectId) {
      return hasProjectRole(projectId, 'admin') || hasProjectRole(projectId, 'editor');
    }
    // Who may hand out access to a project: its admins, the person who created
    // it, and admins/owners of the workspace it lives in.
    function canAdministerProject(projectId) {
      return isApproved()
          && projectId is string
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && (
            hasProjectRole(projectId, 'admin')
            || get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
            || isWorkspaceAdmin(get(/databases/$(database)/documents/projects/$(projectId)).data.get('workspaceId', ''))
          );
    }

    // ─── Workspaces ─────────────────────────────────────────────────────────
    // Helper: a self-update is one where the only fields changed are
    // memberProfiles + updatedAt, AND the only key in memberProfiles that
    // changed is the caller's own UID slot. Used so any workspace member can
    // keep their own display-name slot fresh without admin privileges.
    function isMemberSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let changedProfileKeys = request.resource.data.memberProfiles
        .diff(resource.data.get('memberProfiles', {}))
        .affectedKeys();
      return isApproved()
          && request.auth.uid in resource.data.members
          && changed.hasOnly(['memberProfiles', 'updatedAt'])
          && changedProfileKeys.hasOnly([request.auth.uid]);
    }

    // Somebody was invited by email and is now claiming that invitation. The
    // workspace names their address in pendingInviteEmails, so the invitation
    // itself is the proof — no UID ever has to change hands. The claim may add
    // exactly the claimer, at exactly the role offered, and must clear the
    // invitation as it goes.
    function isClaimingWorkspaceInvite() {
      let email = request.auth.token.email.lower();
      return isApproved()
          && email != null
          && email in resource.data.get('pendingInviteEmails', [])
          && request.resource.data.get('lastClaimedInviteEmail', '') == email
          // …at exactly the role the invitation offered. Without this, the
          // claimer could write themselves 'owner' on the way in.
          && request.resource.data.acl[request.auth.uid]
               == resource.data.get('pendingInviteRoles', {})[email]
          // Only this person joins, and only their own ACL slot appears.
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.acl.diff(resource.data.acl).affectedKeys()
               .hasOnly([request.auth.uid])
          // The invitation is consumed, not left lying around.
          && !(email in request.resource.data.get('pendingInviteEmails', []))
          // Nothing else about the workspace changes.
          && request.resource.data.name == resource.data.name
          && request.resource.data.createdByUserId == resource.data.createdByUserId
          && request.resource.data.get('deleted', false) == resource.data.get('deleted', false);
    }

    match /workspaces/{workspaceId} {
      // Anyone in the members array can read the workspace.
      allow read:   if isApproved() && request.auth.uid in resource.data.members;
      // Any approved user can create their own workspace.
      allow create: if isApproved()
                    && request.resource.data.createdByUserId == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.acl[request.auth.uid] == 'owner';
      // Updates: owners + admins can mutate anything. Any member can update
      // their own slot in memberProfiles (for display-name resolution).
      allow update: if isApproved()
                    && (resource.data.acl[request.auth.uid] == 'owner'
                        || resource.data.acl[request.auth.uid] == 'admin'
                        || isMemberSelfProfileUpdate()
                        || isClaimingWorkspaceInvite());
      // Only the original owner can delete the workspace (soft delete in practice).
      allow delete: if isApproved()
                    && resource.data.acl[request.auth.uid] == 'owner';
    }

    // ─── Projects ───────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read:   if isOwner(resource)
                    || (isApproved() && request.auth.uid in resource.data.members)
                    || isWorkspaceMember(resource.data.workspaceId);
      allow create: if isCreatingOwn() && isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isOwner(resource)
                    || canEditProject(projectId)
                    || canEditWorkspace(resource.data.workspaceId)
                    || isClaimingInvite(projectId);
      allow delete: if isOwner(resource)
                    || hasProjectRole(projectId, 'admin')
                    || isWorkspaceAdmin(resource.data.workspaceId);
    }

    // ─── Tasks ──────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read:   if isOwner(resource)
                    || isWorkspaceMember(resource.data.workspaceId)
                    || (resource.data.projectId is string && isProjectMember(resource.data.projectId));
      // Create allowed when the creator is a workspace member of the target
      // workspace, OR is a member of the project the task is being added to.
      // The project-member branch is what lets a recipient of a SHARED
      // project add tasks even though they're not in the project's workspace.
      allow create: if isCreatingOwn()
                    && (isWorkspaceMember(request.resource.data.workspaceId)
                        || (request.resource.data.projectId is string
                            && isProjectMember(request.resource.data.projectId)));
      allow update: if isOwner(resource)
                    || canEditWorkspace(resource.data.workspaceId)
                    || (resource.data.projectId is string && canEditProject(resource.data.projectId));
      allow delete: if isOwner(resource)
                    || isWorkspaceAdmin(resource.data.workspaceId)
                    || (resource.data.projectId is string && hasProjectRole(resource.data.projectId, 'admin'));
    }

    // ─── Activities ─────────────────────────────────────────────────────────
    match /activities/{activityId} {
      allow read:   if isOwner(resource)
                    || isWorkspaceMember(resource.data.workspaceId)
                    || (resource.data.projectId is string && isProjectMember(resource.data.projectId));
      // Same as tasks: workspace member OR project member of the target.
      allow create: if isCreatingOwn()
                    && (isWorkspaceMember(request.resource.data.workspaceId)
                        || (request.resource.data.projectId is string
                            && isProjectMember(request.resource.data.projectId)));
      allow update: if isOwner(resource)
                    || canEditWorkspace(resource.data.workspaceId)
                    || (resource.data.projectId is string && canEditProject(resource.data.projectId));
      allow delete: if isOwner(resource)
                    || isWorkspaceAdmin(resource.data.workspaceId)
                    || (resource.data.projectId is string && hasProjectRole(resource.data.projectId, 'admin'));
    }

    // ─── Project invites (kept from v9) ─────────────────────────────────────
    function isClaimingInvite(projectId) {
      let inviteId = request.resource.data.lastClaimInviteId;
      let inv = inviteId is string && exists(/databases/$(database)/documents/invites/$(inviteId))
                ? get(/databases/$(database)/documents/invites/$(inviteId)).data
                : null;
      return isApproved()
        && inv != null
        && inv.projectId == projectId
        && inv.revoked != true
        && (!('expiresAt' in inv.keys()) || inv.expiresAt == null || inv.expiresAt > request.time)
        && inv.role == request.resource.data.acl[request.auth.uid]
        && request.resource.data.acl[request.auth.uid] is string
        // A claim adds exactly one person — the claimer. Without this, a valid
        // invite for yourself would also let you rewrite everyone else's role.
        && request.resource.data.acl.diff(resource.data.acl).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.userId  == resource.data.userId
        && request.resource.data.name    == resource.data.name
        && request.resource.data.deleted == resource.data.deleted;
    }

    match /invites/{inviteId} {
      // The invite id IS the secret in the share link, so any signed-in user
      // may fetch one by exact id (`get`) in order to claim it. What they must
      // NOT be able to do is enumerate them (`list`) — that would hand every
      // live secret, and every projectId, to anybody with a console open.
      // Listing is for the sharing panel: the creator and project admins.
      allow get:  if isApproved();
      allow list: if isApproved()
                  && (resource.data.userId == request.auth.uid
                      || canAdministerProject(resource.data.projectId));

      // Minting an invite is granting access, so it needs the rights to grant
      // access — not merely a signature. Anyone could sign their own document.
      allow create: if isCreatingOwn()
                    && canAdministerProject(request.resource.data.projectId);

      // The creator may revoke or expire; everybody else may only append their
      // own claim record. `hasOnly(['claims'])` keeps role/projectId/revoked
      // out of reach of the claimer.
      allow update: if isOwner(resource)
                    || canAdministerProject(resource.data.projectId)
                    || (isApproved()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['claims']));
      allow delete: if isOwner(resource) || canAdministerProject(resource.data.projectId);
    }

    // ─── Templates ──────────────────────────────────────────────────────────
    match /templates/{templateId} {
      allow read:   if isOwner(resource) || isWorkspaceMember(resource.data.workspaceId);
      allow create: if isCreatingOwn() && isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isOwner(resource) || canEditWorkspace(resource.data.workspaceId);
      allow delete: if isOwner(resource) || isWorkspaceAdmin(resource.data.workspaceId);
    }

    // ─── Goals (strategic-plan one-pagers, workspace-scoped) ────────────────
    match /goals/{goalId} {
      allow read:   if isOwner(resource) || isWorkspaceMember(resource.data.workspaceId);
      allow create: if isCreatingOwn() && isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isOwner(resource) || canEditWorkspace(resource.data.workspaceId);
      allow delete: if isOwner(resource) || isWorkspaceAdmin(resource.data.workspaceId);
    }

    // ─── Minutes (meeting minutes, workspace-scoped) ────────────────────────
    match /minutes/{minuteId} {
      allow read:   if isOwner(resource) || isWorkspaceMember(resource.data.workspaceId);
      allow create: if isCreatingOwn() && isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isOwner(resource) || canEditWorkspace(resource.data.workspaceId);
      allow delete: if isOwner(resource) || isWorkspaceAdmin(resource.data.workspaceId);
    }

    // ─── Task comments ──────────────────────────────────────────────────────
    match /taskComments/{commentId} {
      // Read / create are extended to project members so recipients of a
      // SHARED project can see and add comments on its tasks even though
      // they're not in the project's workspace.
      allow read:   if isOwner(resource)
                    || isWorkspaceMember(resource.data.workspaceId)
                    || (resource.data.projectId is string && isProjectMember(resource.data.projectId));
      allow create: if isCreatingOwn()
                    && (isWorkspaceMember(request.resource.data.workspaceId)
                        || (request.resource.data.projectId is string
                            && isProjectMember(request.resource.data.projectId)));
      allow update: if isOwner(resource);
      allow delete: if isOwner(resource) || isWorkspaceAdmin(resource.data.workspaceId);
    }

    // ─── Chat: conversations + messages ─────────────────────────────────────
    // A conversation is a closed group: only its members may read or write it,
    // and it must live in a workspace the creator belongs to. Messages inherit
    // access from their conversation's member list.
    match /conversations/{conversationId} {
      allow read:   if isApproved() && request.auth.uid in resource.data.members;
      allow create: if isApproved()
                    && request.resource.data.createdByUserId == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && isWorkspaceMember(request.resource.data.workspaceId);
      // Any current member may update (send → last-message preview, read
      // markers, rename, add members). Membership can't be emptied to lock out.
      allow update: if isApproved() && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read:   if isApproved()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.members;
      allow create: if isApproved()
                    && request.resource.data.senderId == request.auth.uid
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.members;
      allow update, delete: if isApproved() && resource.data.senderId == request.auth.uid;
    }

    // ─── Saved views (personal-per-workspace) ───────────────────────────────
    match /savedViews/{viewId} {
      allow read:   if isOwner(resource);
      allow create: if isCreatingOwn();
      allow update, delete: if isOwner(resource);
    }

    // ─── Presence (workspace-scoped, writes by owner only) ──────────────────
    // A presence doc names a task and the person looking at it. Read access is
    // therefore workspace membership, not "signed in" — otherwise any account
    // could watch every task id and every teammate's name in the whole
    // database. Writers must belong to the workspace they claim.
    match /presence/{docId} {
      allow read:   if isWorkspaceMember(resource.data.get('workspaceId', ''));
      allow create: if isCreatingOwn()
                    && isWorkspaceMember(request.resource.data.get('workspaceId', ''));
      allow update: if isOwner(resource)
                    && isWorkspaceMember(request.resource.data.get('workspaceId', ''));
      allow delete: if isOwner(resource);
    }

    // ─── Webhooks (workspace-scoped admin tool) ─────────────────────────────
    match /webhooks/{hookId} {
      allow read:   if isOwner(resource) || isWorkspaceAdmin(resource.data.workspaceId);
      allow create: if isCreatingOwn() && isWorkspaceMember(request.resource.data.workspaceId);
      allow update: if isOwner(resource) || isWorkspaceAdmin(resource.data.workspaceId);
      allow delete: if isOwner(resource) || isWorkspaceAdmin(resource.data.workspaceId);
    }

    // ─── Webhook delivery log (written by the webhook functions) ───────────
    // Admins of the workspace can see what was sent and what came back. Nobody
    // writes it from a browser — the function does, with admin credentials.
    match /webhookDeliveries/{deliveryId} {
      allow read:  if isWorkspaceAdmin(resource.data.workspaceId);
      allow write: if false;
    }

    // ─── Legacy categories (unused) ─────────────────────────────────────────
    match /categories/{categoryId} {
      allow read:   if isOwner(resource);
      allow create: if isCreatingOwn();
      allow update, delete: if isOwner(resource);
    }

    // ─── Companies (billing/admin construct that owns an Anthropic key) ────
    // Each user belongs to at most one company (users/{uid}.companyId). AI
    // calls made by any company member use the company's API key, so an
    // admin can budget Anthropic spend per company. Only superadmins can
    // create / edit / delete companies; company members can read just their
    // own company doc (to fetch the shared key client-side).
    function isMyCompany(companyId) {
      return isApproved()
          && companyId is string
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId;
    }
    match /companies/{companyId} {
      // Members read the company for its NAME and its AI switch. The Anthropic
      // key is not here any more — see the secrets subcollection below.
      allow read:   if isApprovedSuperadmin() || isMyCompany(companyId);
      allow create, update, delete: if isApprovedSuperadmin();

      // The shared API key. Only a superadmin (who sets it) and the server-side
      // aiProxy function (which runs with admin credentials and bypasses these
      // rules) may read it. Previously it sat on the company document itself,
      // which meant every member's browser was handed a spendable secret.
      match /secrets/{secretId} {
        allow read, write: if isApprovedSuperadmin();
      }
    }

    // ─── AI usage log (written by the aiProxy function) ─────────────────────
    // A member can see what they spent; a superadmin can see everything. Nobody
    // writes it from a browser — the function does, with admin credentials.
    match /aiUsage/{entryId} {
      allow read:   if isApprovedSuperadmin()
                    || (isApproved() && resource.data.userId == request.auth.uid);
      allow write:  if false;
    }

    // ─── Users (approval-gated access control) ──────────────────────────────
    // Each authenticated user has a doc at users/{uid} carrying their status
    // (pending | approved | rejected) and role (user | superadmin).
    match /users/{userId} {
      // Users can always read their own profile (so the auth gate can fetch
      // status on sign-in). Approved superadmins can read all profiles to
      // power the User Management UI.
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isApprovedSuperadmin());

      // First-time profile creation on sign-in. The user creates their own
      // doc; status must start as 'pending' (role 'user') unless the email
      // matches the hardcoded superadmin list — in which case they may
      // self-create as approved superadmin.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && (
                      (request.resource.data.status == 'pending'
                        && request.resource.data.role == 'user')
                      ||
                      (request.resource.data.status == 'approved'
                        && request.resource.data.role == 'superadmin'
                        && isSuperadminEmail(request.auth.token.email))
                    );

      // Self-update is an allowlist, not a denylist. Enumerating immutable
      // fields leaves every field nobody thought of writable — that is how a
      // member could set their own `companyId` and then read that company's
      // shared Anthropic key through the isMyCompany() branch above. Only the
      // three display fields may be written by the user themselves; anything
      // else (status, role, companyId, and any field added later) is a
      // superadmin's to set.
      function isSelfDisplayEdit(userId) {
        return request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoURL', 'email'])
            && request.resource.data.email == request.auth.token.email;
      }

      // Mirrors the create rule: an email on the hardcoded superadmin list may
      // promote itself. Needed when the list gains an email after that person
      // has already signed in once — without it they can never reach
      // isApprovedSuperadmin() and the whole admin surface locks up.
      function isSelfPromotingSuperadmin(userId) {
        return request.auth.uid == userId
            && isSuperadminEmail(request.auth.token.email)
            && request.resource.data.email  == request.auth.token.email
            && request.resource.data.role   == 'superadmin'
            && request.resource.data.status == 'approved';
      }

      allow update: if request.auth != null
                    && (
                      isApprovedSuperadmin()
                      || isSelfPromotingSuperadmin(userId)
                      || isSelfDisplayEdit(userId)
                    );

      // No deletes — historical records are kept.
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
