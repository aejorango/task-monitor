# Copy this file to ".env" (no "example" suffix) and fill in real values.
# Get all six values from Firebase Console → Project settings → Your apps → Web app config.
#
# IMPORTANT: every variable MUST start with VITE_ or Vite won't expose it.
# IMPORTANT: never commit the real .env — it's in .gitignore for a reason.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ─── AI (optional) ────────────────────────────────────────────────────────
# The default AI brain is the Claude Code CLI, reached through the local
# bridge (`npm run bridge`). It needs NO key — it runs on your Claude
# Pro/Max subscription. Nothing below is required for that.
#
# These are read by the BRIDGE process (bridge/server.mjs), not by Vite, so
# they must NOT be prefixed with VITE_ and are never bundled into the app:
#
#   ANTHROPIC_API_KEY=sk-ant-...     # optional fallback when the CLI fails
#   AI_PROVIDER=claude-code          # pin a provider: claude-code | api | mock
#   TM_BRIDGE_PORT=4319              # default 4319
#   TM_BRIDGE_ORIGINS=https://your.app   # extra allowed origins (comma-separated)
