{
  "name": "task-monitor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "bridge": "node bridge/server.mjs",
    "test": "node --import ./tests/ui/jsx-loader.mjs --test bridge/*.test.mjs src/**/*.test.mjs src/templates/*.test.mjs tests/ui/*.test.mjs functions/src/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project task-monitor-rules-test 'node --test tests/rules/*.test.mjs'",
    "test:all": "npm test && npm run test:rules",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "node scripts/firebase-deploy.mjs hosting",
    "deploy:pages": "gh-pages -d dist",
    "deploy:rules": "node scripts/firebase-deploy.mjs rules",
    "deploy:all": "node scripts/firebase-deploy.mjs all",
    "deploy:functions": "node scripts/firebase-deploy.mjs functions",
    "deploy:indexes": "node scripts/firebase-deploy.mjs indexes"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.13.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jsdom": "^30.1.0",
    "vite": "^8.0.12"
  }
}
