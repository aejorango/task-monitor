{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "bridge",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "bridge"
      ],
      "port": 4319
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "mobile-harness",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--config",
        "dev/mobile.vite.config.js",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    },
    {
      "name": "desktop-harness",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "HARNESS=desktop",
        "npx",
        "vite",
        "--config",
        "dev/mobile.vite.config.js",
        "--port",
        "5178",
        "--strictPort"
      ],
      "port": 5178
    }
  ]
}